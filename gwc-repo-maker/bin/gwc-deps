#!/bin/sh
# gwc-repo-maker doctor        : detect the distro and report what is missing
# gwc-repo-maker install-deps  : install system packages (sudo) + Python deps (private .venv if still missing); --print = only show the command
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. /etc/os-release 2>/dev/null || true
case " $ID $ID_LIKE " in
  *" debian "*|*" ubuntu "*) FAM=debian; INST="apt-get install -y"; PKGS="gjs gir1.2-gtk-4.0 gir1.2-adw-1 python3 python3-venv python3-cryptography python3-pil git" ;;
  *" fedora "*|*" rhel "*)   FAM=fedora; INST="dnf install -y"; PKGS="gjs gtk4 libadwaita python3 python3-cryptography python3-pillow git" ;;
  *" arch "*)                FAM=arch;   INST="pacman -S --needed --noconfirm"; PKGS="gjs gtk4 libadwaita python python-cryptography python-pillow git" ;;
  *" suse "*)                FAM=suse;   INST="zypper install -y"; PKGS="gjs typelib-1_0-Gtk-4_0 typelib-1_0-Adw-1 python3 python3-cryptography python3-Pillow git" ;;
  *) FAM=unknown ;;
esac
PY="$DIR/.venv/bin/python3"; [ -x "$PY" ] || PY="$(command -v python3 || true)"
have_py() { [ -n "$PY" ] && "$PY" -c "import $1" >/dev/null 2>&1; }

doctor() {
  echo "distro: ${PRETTY_NAME:-unknown} (id=${ID:-?} like=${ID_LIKE:-} -> $FAM)"
  miss=0
  chk() { if "$2"; then echo "  ok       $1"; else echo "  MISSING  $1"; [ "$3" = opt ] || miss=1; fi; }
  c_gjs() { command -v gjs >/dev/null; }
  c_gtk() { gjs -c 'imports.gi.versions.Gtk="4.0";imports.gi.versions.Adw="1";imports.gi.Gtk;imports.gi.Adw' >/dev/null 2>&1; }
  c_py() { [ -n "$PY" ]; }; c_cr() { have_py cryptography; }; c_pil() { have_py PIL; }; c_git() { command -v git >/dev/null; }
  chk "gjs" c_gjs; chk "GTK 4 + libadwaita typelibs" c_gtk; chk "python3" c_py
  chk "python: cryptography (required)" c_cr; chk "python: Pillow (optional, covers)" c_pil opt; chk "git" c_git
  [ "$miss" = 0 ] && echo "all good" || echo "fix with: gwc-repo-maker install-deps"
  return $miss
}

install_deps() {
  [ "$FAM" != unknown ] || { echo "unknown distro: install manually (see README): gjs, GTK4, libadwaita, python3, cryptography, Pillow, git" >&2; exit 1; }
  SUDO=""; [ "$(id -u)" = 0 ] || SUDO="sudo"
  [ "$FAM" = debian ] && [ -z "$SUDO" ] && INST="apt-get install -y" || true
  echo "$SUDO $INST $PKGS"
  [ "$1" = --print ] && return 0
  $SUDO $INST $PKGS || echo "system install failed or was cancelled; trying Python deps only" >&2
  PY="$(command -v python3 || true)"
  if have_py cryptography; then echo "python deps ok"; return 0; fi
  [ -n "$PY" ] || { echo "python3 still missing" >&2; exit 1; }
  echo "installing Python deps into $DIR/.venv"
  rm -rf "$DIR/.venv" && "$PY" -m venv "$DIR/.venv" && "$DIR/.venv/bin/python3" -m pip install -r "$DIR/backend/tools/requirements.txt" \
    || { rm -rf "$DIR/.venv"; echo "venv/pip failed (no network, or the venv module is missing)" >&2; exit 1; }
}

case "$1" in doctor) doctor ;; install-deps) shift; install_deps "$@" || exit 1; [ "$1" = --print ] || { [ -x "$DIR/.venv/bin/python3" ] && PY="$DIR/.venv/bin/python3"; doctor; } ;; *) echo "usage: $0 doctor|install-deps [--print]" >&2; exit 2 ;; esac
